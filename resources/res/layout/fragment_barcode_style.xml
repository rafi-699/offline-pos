<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_barcode_style_0"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"
            android:paddingHorizontal="14dp">
            <TextView
                android:textSize="@dimen/text_size_big"
                android:textColor="@color/color_000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="@dimen/text_size_big"
                    android:textColor="@color/color_red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hand"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_pull_up"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/bg_op_round"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"
            android:paddingHorizontal="14dp">
            <TextView
                android:textSize="@dimen/text_size_big"
                android:textColor="@color/color_000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="40dp"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginEnd="60dp"/>
            <ImageView
                android:tag="binding_2"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_scan"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="5dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/bg_op_round"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"
            android:paddingHorizontal="14dp">
            <TextView
                android:textSize="@dimen/text_size_big"
                android:textColor="@color/color_000"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="40dp"
                android:text="@string/code_format"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/code_style_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="@dimen/text_size_big"
                    android:textColor="@color/black"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="30dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_pull_up"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_op_round"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"
            android:paddingHorizontal="14dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/text_size_big"
                    android:textColor="@color/color_000"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="40dp"
                    android:text="@string/style"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@+id/style_bottom"
                        android:tag="binding_4"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/barcode_bottom_selector"
                        android:layout_marginStart="15dp"
                        android:paddingHorizontal="5dp"/>
                    <ImageView
                        android:id="@+id/style_center"
                        android:tag="binding_5"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/barcode_center_selector"
                        android:layout_marginStart="15dp"
                        android:paddingHorizontal="5dp"/>
                    <ImageView
                        android:id="@+id/style_top"
                        android:tag="binding_6"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/barcode_top_selector"
                        android:layout_marginStart="15dp"
                        android:paddingHorizontal="5dp"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/text_size_big"
                    android:textColor="@color/color_000"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="40dp"
                    android:text="@string/size"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:tag="binding_7"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_op_minus"/>
                    <TextView
                        android:textSize="@dimen/text_size_larger"
                        android:textColor="@color/color_333"
                        android:tag="binding_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:layout_marginRight="30dp"
                        android:layout_marginHorizontal="30dp"/>
                    <ImageView
                        android:tag="binding_9"
                        android:paddingLeft="5dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_op_add"
                        android:paddingVertical="5dp"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="6dp"
            android:layout_marginHorizontal="6dp"
            android:paddingHorizontal="14dp">
            <TextView
                android:textSize="@dimen/text_size_big"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_alignParentEnd="true">
                <CheckBox
                    android:id="@+id/color_black"
                    android:tag="binding_10"
                    android:background="@drawable/color_style_black_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/MyCheckBoxStyle"/>
                <CheckBox
                    android:id="@+id/color_red"
                    android:tag="binding_11"
                    android:background="@drawable/color_style_red_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    style="@style/MyCheckBoxStyle"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
