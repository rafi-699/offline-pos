<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_image_convert_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="18dp">
        <TextView
            android:textSize="@dimen/text_size_big"
            android:textColor="@color/color_000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uniform_scaling"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/scale_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/switch_thumb"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:track="@drawable/switch_track_selector"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="18dp">
        <TextView
            android:textSize="@dimen/text_size_big"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intensity"/>
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:maxHeight="6dp"
            android:max="100"
            android:progress="50"
            android:layout_weight="1"
            android:progressTint="@color/color_00A3C8"
            android:progressBackgroundTint="#e3e3e3"
            android:thumbTint="@color/color_00A3C8"
            android:min="0"
            android:layout_marginHorizontal="10dp"/>
    </LinearLayout>
</LinearLayout>
